@model IEnumerable<Yatırım.Models.FinansVarlik>

@{
    ViewData["Title"] = "Canlı Piyasa Ekranı";
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h2 class="fw-bold mb-1 text-light-theme">Piyasa Takip Paneli</h2>
        <p class="text-muted mb-0">Güncel döviz, emtia ve hisse senedi fiyatları ile otomatik yatırım tavsiyeleri.</p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <a asp-action="Ekle" class="btn btn-primary-custom">
            <i class="fa-solid fa-plus me-2"></i>Yeni Varlık Ekle
        </a>
    </div>
</div>

<!-- Canlı Bilgi Kartları (Ticker Cards) -->
<div class="row g-3 mb-5">
    @foreach (var item in Model.Take(4))
    {
        var isUp = item.GunlukDegisim > 0;
        var isDown = item.GunlukDegisim < 0;
        var trendClass = isUp ? "up" : (isDown ? "down" : "flat");
        var textClass = isUp ? "text-up" : (isDown ? "text-down" : "text-flat");
        var iconClass = isUp ? "fa-arrow-trend-up" : (isDown ? "fa-arrow-trend-down" : "fa-arrows-left-right");

        <div class="col-md-6 col-lg-3">
            <div class="fin-card @trendClass h-100">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <span class="badge bg-secondary text-light-theme bg-opacity-25 fs-7">@item.VarlikTuru</span>
                        <h5 class="fw-bold mt-2 mb-0">@item.VarlikAdi</h5>
                    </div>
                    <span class="fs-4 @textClass">
                        <i class="fa-solid @iconClass"></i>
                    </span>
                </div>
                <div class="d-flex justify-content-between align-items-baseline mt-3">
                    <span class="fs-3 fw-bold font-monospace">@item.SatisFiyati.ToString("N2") ₺</span>
                    <span class="fw-semibold @textClass font-monospace">
                        @(isUp ? "+" : "")@item.GunlukDegisim.ToString("N2")%
                    </span>
                </div>
                <div class="mt-3 pt-2 border-top border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
                    <span class="text-muted fs-7">Tavsiye:</span>
                    @{
                        var badgeClass = item.Tavsiye == "GÜÇLÜ AL" ? "bg-success-glow" : 
                                         (item.Tavsiye == "TUT / BEKLE" ? "bg-warning-glow" : "bg-danger-glow");
                    }
                    <span class="badge-glow @badgeClass">@item.Tavsiye</span>
                </div>
            </div>
        </div>
    }
</div>

<!-- Ana Piyasa Tablosu -->
<div class="card bg-card-theme border border-secondary border-opacity-50 shadow-lg rounded-3">
    <div class="card-header bg-black bg-opacity-20 py-3 d-flex justify-content-between align-items-center border-bottom border-secondary border-opacity-50">
        <h5 class="fw-bold mb-0 text-accent">Tüm Varlıklar</h5>
        <span class="badge bg-primary bg-opacity-20 text-accent">Toplam @Model.Count() Enstrüman</span>
    </div>
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0">
            <thead class="table-light bg-opacity-10 text-muted uppercase font-monospace text-xs">
                <tr>
                    <th scope="col" class="ps-4">Varlık Adı</th>
                    <th scope="col">Tür</th>
                    <th scope="col" class="text-end">Alış Fiyatı</th>
                    <th scope="col" class="text-end">Satış Fiyatı</th>
                    <th scope="col" class="text-center">Günlük Değişim</th>
                    <th scope="col" class="text-center">Öneri</th>
                    <th scope="col" class="text-center">Son Güncelleme</th>
                    <th scope="col" class="pe-4 text-center">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var isUp = item.GunlukDegisim > 0;
                    var isDown = item.GunlukDegisim < 0;
                    var textClass = isUp ? "text-up" : (isDown ? "text-down" : "text-flat");
                    var badgeClass = item.Tavsiye == "GÜÇLÜ AL" ? "bg-success-glow" : 
                                     (item.Tavsiye == "TUT / BEKLE" ? "bg-warning-glow" : "bg-danger-glow");

                    <tr>
                        <td class="ps-4 fw-bold">@item.VarlikAdi</td>
                        <td>
                            <span class="badge bg-secondary bg-opacity-25 text-light-theme">@item.VarlikTuru</span>
                        </td>
                        <td class="text-end font-monospace">@item.AlisFiyati.ToString("N2") ₺</td>
                        <td class="text-end font-monospace fw-semibold">@item.SatisFiyati.ToString("N2") ₺</td>
                        <td class="text-center font-monospace @textClass">
                            <i class="fa-solid @(isUp ? "fa-caret-up" : (isDown ? "fa-caret-down" : "fa-minus")) me-1"></i>
                            @(isUp ? "+" : "")@item.GunlukDegisim.ToString("N2")%
                        </td>
                        <td class="text-center">
                            <span class="badge-glow @badgeClass">@item.Tavsiye</span>
                        </td>
                        <td class="text-center text-muted fs-7">@item.SonGuncelleme.ToString("HH:mm:ss")</td>
                        <td class="pe-4 text-center">
                            <a asp-action="PortfoyHesapla" asp-route-varlikId="@item.Id" class="btn btn-sm btn-secondary-custom">
                                <i class="fa-solid fa-calculator me-1"></i> Hesapla
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
