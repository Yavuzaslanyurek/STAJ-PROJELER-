@model Yatırım.Models.FinansVarlik

@{
    ViewData["Title"] = "Yeni Varlık Ekle";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <h2 class="fw-bold mb-1 text-light-theme text-center">Yeni Varlık / Enstrüman Ekle</h2>
        <p class="text-muted mb-4 text-center">Takip listesine ve borsa ekranına eklenecek yeni kurları veya hisse senetlerini tanımlayın.</p>

        <div class="form-card">
            <form asp-action="Ekle" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="VarlikAdi" class="form-label text-light-theme fw-semibold"></label>
                    <input asp-for="VarlikAdi" class="form-control form-control-dark" placeholder="Örn: BTC/TRY, XAU/USD, EREGL" required />
                    <span asp-validation-for="VarlikAdi" class="text-danger fs-7"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="VarlikTuru" class="form-label text-light-theme fw-semibold"></label>
                    <select asp-for="VarlikTuru" class="form-select form-select-dark" required>
                        <option value="" disabled selected>-- Tür Seçin --</option>
                        <option value="Döviz">Döviz (Kur)</option>
                        <option value="Emtia">Emtia (Altın, Gümüş vb.)</option>
                        <option value="Hisse">Hisse (Borsa İstanbul / Global)</option>
                    </select>
                    <span asp-validation-for="VarlikTuru" class="text-danger fs-7"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="AlisFiyati" class="form-label text-light-theme fw-semibold"></label>
                        <div class="input-group">
                            <input asp-for="AlisFiyati" type="number" step="0.0001" class="form-control form-control-dark" placeholder="0.00" required />
                            <span class="input-group-text bg-card-theme border-secondary text-muted">₺</span>
                        </div>
                        <span asp-validation-for="AlisFiyati" class="text-danger fs-7"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="SatisFiyati" class="form-label text-light-theme fw-semibold"></label>
                        <div class="input-group">
                            <input asp-for="SatisFiyati" type="number" step="0.0001" class="form-control form-control-dark" placeholder="0.00" required />
                            <span class="input-group-text bg-card-theme border-secondary text-muted">₺</span>
                        </div>
                        <span asp-validation-for="SatisFiyati" class="text-danger fs-7"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="GunlukDegisim" class="form-label text-light-theme fw-semibold"></label>
                    <div class="input-group">
                        <input asp-for="GunlukDegisim" type="number" step="0.01" class="form-control form-control-dark" placeholder="Örn: 1.25 veya -2.40" required />
                        <span class="input-group-text bg-card-theme border-secondary text-muted">%</span>
                    </div>
                    <div class="form-text text-muted fs-7">Değerin pozitif olması durumunda yükseliş (yeşil), negatif olması durumunda düşüş (kırmızı) işlenecektir.</div>
                    <span asp-validation-for="GunlukDegisim" class="text-danger fs-7"></span>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary-custom py-2">
                        <i class="fa-solid fa-cloud-arrow-up me-2"></i>Varlığı Kaydet
                    </button>
                    <a asp-action="Index" class="btn btn-secondary-custom py-2">
                        <i class="fa-solid fa-arrow-left me-2"></i>Piyasa Ekranına Dön
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
