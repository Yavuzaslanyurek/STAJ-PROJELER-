<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Yatırım Finans Portalı</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- FontAwesome for professional financial icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Yatırım.styles.css" asp-append-version="true" />
</head>
<body class="bg-dark-theme text-light-theme">
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-card-theme border-bottom-secondary box-shadow-soft mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold text-accent" asp-area="" asp-controller="Finans" asp-action="Index">
                    <i class="fa-solid fa-chart-line-up mr-2"></i> YATIRIM
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-area="" asp-controller="Finans" asp-action="Index">
                                <i class="fa-solid fa-chart-pie me-1"></i> Piyasa Ekranı
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-area="" asp-controller="Finans" asp-action="PortfoyHesapla">
                                <i class="fa-solid fa-calculator me-1"></i> Portföy Hesapla
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-area="" asp-controller="Finans" asp-action="Ekle">
                                <i class="fa-solid fa-circle-plus me-1"></i> Varlık Ekle
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center text-muted fs-7">
                        <span class="badge bg-success-glow me-2"><i class="fa-solid fa-circle-dot animate-pulse"></i> Canlı Bağlantı</span>
                        <span id="clock-display" class="font-monospace"></span>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-card-theme border-top-secondary footer text-muted py-3">
        <div class="container text-center">
            &copy; 2026 - Yatırım Finans Portalı - Her Hakkı Saklıdır.
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Simple live clock for the financial dashboard feel
        function updateClock() {
            const now = new Date();
            const timeString = now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            document.getElementById('clock-display').textContent = timeString;
        }
        setInterval(updateClock, 1000);
        updateClock();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
